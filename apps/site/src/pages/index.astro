---
import { Picture } from "astro:assets";
import appScreenshot from "../assets/app-dashboard.png";
import BrandMark from "../components/BrandMark.astro";
import SectionHeading from "../components/SectionHeading.astro";
import { product } from "../config";
import { guides } from "../data/pages";
import { latestRelease } from "../data/releases";
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredGuides = [
  "/guides/switch-claude-code-accounts-mac",
  "/guides/multiple-claude-accounts-allowed",
  "/guides/claude-code-limit-reached",
].map((path) => guides.find((guide) => guide.path === path)!);

const faqs = [
  {
    question: "What exactly changes on disk when I switch?",
    answer:
      "Only the selected provider's authentication fields. settings.json, MCP server definitions, hooks, permissions, instructions, and local history are left byte-for-byte alone. The app captures the current login first, stages rollback material, then verifies the restored identity before it cleans up.",
  },
  {
    question: "What happens if a switch fails halfway?",
    answer:
      "It rolls back. If another process rewrote a credential while the switch was running, that external change wins and the switch aborts rather than overwriting it. If a safe rollback is not possible, the app keeps a protected recovery directory and tells you, instead of guessing.",
  },
  {
    question: "Can I keep work and personal accounts separate?",
    answer:
      "Yes. Each saved account has its own identity, usage reading, and Keychain-protected credential snapshot. Quotas stay separate and provider-enforced; nothing is pooled or merged. Use only accounts you are authorized to access and follow the provider and workplace policies that apply to them.",
  },
  {
    question: "Which accounts does Limit Lifeboat support?",
    answer:
      "It supports Claude subscription accounts used by Claude Code and ChatGPT subscription accounts used by the Codex CLI. You can use either provider or both.",
  },
  {
    question: "Does it switch accounts automatically?",
    answer:
      "Only if you turn that on, and it is off by default. When enabled, it moves off the active account at 5% session remaining or 1% weekly remaining, follows your saved priority order, and requires the target account to have at least 30% headroom and to be at least 20 points better than the one you are leaving.",
  },
  {
    question: "Does it switch my browser or desktop app too?",
    answer:
      "No. Browser, Claude Desktop, ChatGPT Desktop, and CLI sessions are separate. Limit Lifeboat switches the corresponding command-line tool only.",
  },
  {
    question: "Does the app update itself?",
    answer:
      "It checks the signed update feed once a day by default, but it never installs silently. Every update requires you to choose Install and Relaunch.",
  },
  {
    question: "Where does my account data live?",
    answer:
      "Profiles and usage history stay in your user Library. App-managed credential snapshots are encrypted by macOS Keychain. There is no product analytics, advertising, or telemetry.",
  },
  {
    question: "Can I use an Intel Mac?",
    answer:
      `Not in version ${product.version}. Limit Lifeboat requires an Apple Silicon Mac running ${product.minimumMacOS} or newer.`,
  },
] as const;

const structuredData = [
  {
    "@type": "SoftwareApplication",
    "@id": `${product.siteUrl}/#software`,
    name: product.name,
    url: product.siteUrl,
    description: product.metaDescription,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Account and usage management",
    operatingSystem: `${product.minimumMacOS} or newer`,
    processorRequirements: "arm64",
    softwareRequirements: `${product.architecture} Mac running ${product.minimumMacOS} or newer, plus Claude Code and/or the Codex CLI`,
    softwareVersion: product.version,
    datePublished: "2026-07-15",
    dateModified: latestRelease.date,
    releaseNotes: new URL("/changelog", product.siteUrl).toString(),
    downloadUrl: product.links.download,
    installUrl: new URL("/download", product.siteUrl).toString(),
    screenshot: new URL("/og-card.png", product.siteUrl).toString(),
    codeRepository: product.links.repository,
    license: product.links.license,
    isAccessibleForFree: true,
    author: { "@id": `${product.siteUrl}/#organization` },
    maintainer: { "@id": `${product.siteUrl}/#organization` },
    featureList: [
      "Switch Claude Code and Codex CLI logins between saved accounts",
      "Write only provider authentication fields, never settings.json or MCP definitions",
      "Verify the restored account identity after every switch",
      "Roll back a failed switch, or keep protected recovery material when rollback is unsafe",
      "Show session, weekly, and model-scoped usage windows for every saved account",
      "Display the age of each usage reading instead of presenting stale data as live",
      "Optional warnings before a limit interrupts work, and when an account is likely available again",
      "Optional automatic switching, off by default",
      "Local usage history with CSV export",
    ],
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: new URL("/download", product.siteUrl).toString(),
    },
  },
  {
    "@type": "FAQPage",
    "@id": `${product.siteUrl}/#faq`,
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<BaseLayout
  title="Claude Code & Codex Account Switcher for Mac"
  description={product.metaDescription}
  dateModified={latestRelease.date}
  structuredData={structuredData}
>
  <section class="hero">
    <div class="hero-orb hero-orb--one" aria-hidden="true"></div>
    <div class="hero-orb hero-orb--two" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">
          <span class="status-dot"></span>
          Native macOS menu-bar app
        </p>
        <h1>Switch Claude Code and Codex accounts <span>without breaking your setup.</span></h1>
        <p class="hero-lead">
          Most switchers move the credential and leave you to discover what else they changed.
          This one restores only the auth fields, verifies which account you actually landed on,
          and rolls back if it cannot finish. Your <code>settings.json</code>, MCP servers, and
          hooks are never touched.
        </p>
        <div class="hero-actions">
          <a class="button button--primary button--large" href={product.links.download}>
            <svg aria-hidden="true" viewBox="0 0 18 18" width="18" height="18">
              <path d="M9 2v9m0 0 3.5-3.5M9 11 5.5 7.5M3 15h12" />
            </svg>
            Download for Mac
          </a>
          <a class="button button--secondary button--large" href={product.links.repository}>
            Inspect the source on GitHub
            <svg aria-hidden="true" viewBox="0 0 18 18" width="18" height="18">
              <path d="M5 13 13 5m0 0H6m7 0v7" />
            </svg>
          </a>
        </div>
        <ul class="hero-notes" aria-label="Download details">
          <li>
            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="m3 8 3 3 7-7" /></svg>
            Free and open source
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1.8 13 4v3.4c0 3.1-2.1 5.8-5 6.8-2.9-1-5-3.7-5-6.8V4l5-2.2Z" /></svg>
            Signed and notarized
          </li>
          <li>{product.minimumMacOS}+</li>
        </ul>
      </div>

      <div class="hero-visual">
        <div class="shot-glow" aria-hidden="true"></div>
        <div class="product-shot">
          <div class="shot-topline" aria-hidden="true">
            <span></span><span></span><span></span>
            <p>Limit Lifeboat</p>
          </div>
          <Picture
            src={appScreenshot}
            formats={["avif", "webp"]}
            widths={[480, 720, 960, 1187]}
            sizes="(max-width: 760px) 88vw, (max-width: 1100px) 52vw, 560px"
            loading="eager"
            fetchpriority="high"
            alt="Limit Lifeboat menu-bar dashboard showing three Claude accounts and one Codex account with remaining usage meters."
          />
        </div>
        <div class="floating-pill floating-pill--usage" aria-hidden="true">
          <span class="pill-icon pill-icon--green">✓</span>
          <span><strong>All accounts visible</strong>At one glance</span>
        </div>
        <div class="floating-pill floating-pill--local" aria-hidden="true">
          <span class="pill-icon">⌁</span>
          <span><strong>Local-first</strong>Your data stays yours</span>
        </div>
      </div>
    </div>
    <div class="container proof-strip" aria-label="Product highlights">
      <div><strong>Auth fields only</strong><span>settings.json untouched</span></div>
      <div><strong>Identity verified</strong><span>After every switch</span></div>
      <div><strong>Rolls back</strong><span>Or keeps recovery material</span></div>
      <div><strong>Zero telemetry</strong><span>Open source on GitHub</span></div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="container">
      <SectionHeading
        eyebrow="Built for more than one login"
        title="Change the login, not your configuration."
        copy="A switch that goes wrong costs more than the switch saved. Every change is scoped to the credential, checked afterwards, and reversible."
        align="center"
      />
      <div class="feature-grid">
        <article class="feature-card feature-card--wide">
          <div class="feature-copy">
            <span class="feature-icon feature-icon--violet">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 18h16M6 15V9m6 6V5m6 10v-3" /></svg>
            </span>
            <p class="card-kicker">Every account, one view</p>
            <h3>Never spend an afternoon on the wrong account.</h3>
            <p>The CLI shows one identity at a time, and a switch that moves the credential without moving the identity will happily bill the wrong employer. See every saved account, which one the CLI is really logged into, what each has left, and how old each reading is.</p>
          </div>
          <div class="meter-demo" aria-hidden="true">
            <div class="demo-account"><span class="provider-glyph provider-glyph--claude">✦</span><strong>Claude</strong><span>3 accounts</span></div>
            <div class="demo-row">
              <span class="avatar avatar--violet">P</span>
              <div><strong>Personal</strong><small>Session</small></div>
              <div class="mini-meter"><span style="width: 66%"></span></div>
              <b>66%</b>
            </div>
            <div class="demo-row">
              <span class="avatar avatar--blue">W</span>
              <div><strong>Work</strong><small>Weekly</small></div>
              <div class="mini-meter"><span style="width: 28%"></span></div>
              <b>28%</b>
            </div>
          </div>
        </article>

        <article class="feature-card">
          <span class="feature-icon feature-icon--cyan">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 7h11m0 0-3-3m3 3-3 3M16 17H5m0 0 3 3m-3-3 3-3" /></svg>
          </span>
          <p class="card-kicker">Transactional switching</p>
          <h3>A switch that assumes it will be interrupted.</h3>
          <p>It stages rollback material, restores only the auth fields, then verifies the account it landed on. If another process rewrites a credential mid-switch, that change wins and the switch aborts rather than overwriting it.</p>
          <div class="switch-demo" aria-hidden="true">
            <span><i class="avatar avatar--violet">P</i>Personal</span>
            <svg viewBox="0 0 32 20"><path d="M3 7h23m0 0-5-5m5 5-5 5M29 13H6m0 0 5 5m-5-5 5-5" /></svg>
            <span><i class="avatar avatar--blue">W</i>Work</span>
          </div>
        </article>

        <article class="feature-card">
          <span class="feature-icon feature-icon--amber">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 4a6 6 0 0 0-6 6c0 7-3 7-3 7h18s-3 0-3-7a6 6 0 0 0-6-6Zm-2 16h4" /></svg>
          </span>
          <p class="card-kicker">Useful, optional warnings</p>
          <h3>Hear about limits before they interrupt you.</h3>
          <p>Get a notification when an account is nearly depleted—or likely ready to use again. You choose which alerts are enabled.</p>
          <div class="notice-demo" aria-hidden="true">
            <BrandMark size={38} />
            <span><strong>Claude Work is at 89%</strong>Review your accounts before the next task.</span>
          </div>
        </article>

        <article class="feature-card feature-card--history">
          <span class="feature-icon feature-icon--green">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19V9m5 10V5m5 14v-7m5 7V8" /></svg>
          </span>
          <p class="card-kicker">Usage history</p>
          <h3>See the rhythm, not just the number.</h3>
          <p>Local history helps reveal how quickly a limit is moving and whether the current pace is sustainable.</p>
          <div class="history-chart" aria-hidden="true">
            <svg viewBox="0 0 420 116" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chart-fill" x1="0" y1="0" x2="0" y2="1">
                  <stop stop-color="#5d42c3" stop-opacity=".28" />
                  <stop offset="1" stop-color="#5d42c3" stop-opacity="0" />
                </linearGradient>
              </defs>
              <path class="chart-area" d="M0 99C45 96 48 84 88 83s60-25 104-20 49-23 95-15 61-30 133-38v106H0Z" />
              <path class="chart-line" d="M0 99C45 96 48 84 88 83s60-25 104-20 49-23 95-15 61-30 133-38" />
            </svg>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section setup-section" id="setup">
    <div class="container">
      <SectionHeading
        eyebrow="Up and running in minutes"
        title="It works with the logins you already have."
        copy="There are no API keys to paste and no new account system to create. Limit Lifeboat works with the CLI logins you already use."
        align="center"
      />
      <ol class="steps">
        <li>
          <span class="step-number">01</span>
          <div class="step-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 4h10v16H7zM10 17h4" /></svg></div>
          <h3>Install the app</h3>
          <p>Download the signed DMG or install the cask with Homebrew. Limit Lifeboat lives in the menu bar.</p>
        </li>
        <li>
          <span class="step-number">02</span>
          <div class="step-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m5 7 4 4-4 4m6 0h8" /></svg></div>
          <h3>Use your CLI logins</h3>
          <p>Log in with <code>claude</code> or <code>codex login</code>. On refresh, the active account registers itself.</p>
        </li>
        <li>
          <span class="step-number">03</span>
          <div class="step-icon"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 4 7v5c0 5 3.4 8 8 9 4.6-1 8-4 8-9V7l-8-4Zm-3 9 2 2 4-5" /></svg></div>
          <h3>Stay in command</h3>
          <p>Watch usage, choose warnings, and switch a CLI only when you decide it is time.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section security-section" id="security">
    <div class="container security-grid">
      <div class="security-visual" aria-hidden="true">
        <div class="security-ring security-ring--outer"></div>
        <div class="security-ring security-ring--middle"></div>
        <div class="shield-card">
          <BrandMark size={84} />
          <span><i></i>Protected by macOS</span>
        </div>
        <div class="security-tag security-tag--keychain">Keychain encrypted</div>
        <div class="security-tag security-tag--telemetry">Zero telemetry</div>
        <div class="security-tag security-tag--rollback">Verified restore</div>
      </div>
      <div class="security-copy">
        <p class="eyebrow">Local-first by design</p>
        <h2>A narrow switch surface, and a way back.</h2>
        <p class="section-copy">Limit Lifeboat handles sensitive CLI authentication material with explicit boundaries, identity checks, and protected recovery.</p>
        <ul class="check-list">
          <li><span>✓</span><div><strong>Only provider authentication fields change</strong><p>Unrelated CLI settings, MCP servers, instructions, and local history stay in place.</p></div></li>
          <li><span>✓</span><div><strong>The restored identity is verified</strong><p>A switch completes only after the selected account is confirmed; failed changes roll back safely.</p></div></li>
          <li><span>✓</span><div><strong>Snapshots are protected by macOS Keychain</strong><p>Temporary rollback material is restricted and removed after a verified switch or recovery.</p></div></li>
          <li><span>✓</span><div><strong>No App Sandbox, for a specific reason</strong><p>Switching must update provider-owned CLI files. The release entitlement is limited to optional Terminal automation.</p></div></li>
        </ul>
        <a class="text-link" href="/privacy">Read the privacy details <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="allowed">
    <div class="container">
      <SectionHeading
        eyebrow="The question everyone asks second"
        title="Is this allowed?"
        copy="Short answer: holding more than one account is normal, and this app does not do the thing providers actually prohibit."
        align="center"
      />
      <div class="allowed-grid">
        <article>
          <h3>What providers prohibit</h3>
          <p>Sharing one account between people, and reselling or proxying subscription inference through third-party harnesses. Limit Lifeboat does neither. It never sends your credentials anywhere, never routes a model request, and never gives two people access to one subscription.</p>
        </article>
        <article>
          <h3>What this actually does</h3>
          <p>It moves your own logins between your own accounts on your own Mac, using the same credential store and the same official CLI you already use. Quotas are enforced by the provider, per account, exactly as before. Nothing is pooled, merged, or extended.</p>
        </article>
        <article>
          <h3>Why people need it</h3>
          <p>The common case is an employer-provisioned account plus a personal one. Both vendors have declined to build switching — the request has been open on Claude Code since January 2026 with several hundred upvotes — so people do it by hand with scripts that overwrite their config.</p>
        </article>
        <article>
          <h3>Where the line is</h3>
          <p>Use only accounts you are authorized to use, and follow whatever policy your employer sets for the account they gave you. That is your call to make, not this app's. It will not create accounts, and it will not touch a browser or desktop-app session.</p>
        </article>
      </div>
      <p class="allowed-more">
        <a class="text-link" href="/guides/multiple-claude-accounts-allowed"
          >Read the long answer, with what the terms actually say <span aria-hidden="true">→</span></a
        >
      </p>
    </div>
  </section>

  <section class="section resources-section" id="resources">
    <div class="container">
      <SectionHeading
        eyebrow="Practical guides"
        title="Understand the workflow before changing it."
        copy="Start with the official CLI path, learn what changes during an account switch, and choose the setup that fits your work and personal accounts."
        align="center"
      />
      <div class="resource-grid">
        {
          featuredGuides.map((guide) => (
            <a class="resource-card" href={guide.path}>
              <span>{guide.eyebrow}</span>
              <h3>{guide.title}</h3>
              <p>{guide.summary}</p>
              <strong>
                Read the guide <i aria-hidden="true">→</i>
              </strong>
            </a>
          ))
        }
      </div>
      <p class="allowed-more">
        <a class="text-link" href="/guides"
          >Browse all {guides.length} guides <span aria-hidden="true">→</span></a
        >
      </p>
    </div>
  </section>

  <section class="section install-section" id="download">
    <div class="container install-shell">
      <div class="install-orb" aria-hidden="true"></div>
      <div class="install-heading">
        <p class="eyebrow eyebrow--light">Free, signed, and notarized</p>
        <h2>Install it and keep your config.</h2>
        <p>Free, open source, and made for Apple Silicon Macs.</p>
      </div>
      <div class="install-grid">
        <article class="install-card install-card--primary">
          <span class="install-label">Recommended</span>
          <div class="install-card-icon">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 21h14" /></svg>
          </div>
          <h3>Signed DMG</h3>
          <p>Download the latest signed and notarized release, then drag Limit Lifeboat to Applications.</p>
          <a class="button button--white" href={product.links.download}>Download for Mac <span aria-hidden="true">→</span></a>
        </article>
        <article class="install-card">
          <span class="install-label">For Homebrew users</span>
          <div class="install-card-icon">
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 5h14v14H5zM8 9l2.5 2.5L8 14m5 0h3" /></svg>
          </div>
          <h3>Homebrew Cask</h3>
          <p>Install from the personal tap. The cask uses the same published DMG as the GitHub release.</p>
          <pre class="command"><code>{product.homebrewCommand}</code></pre>
        </article>
      </div>
      <dl class="requirements">
        <div><dt>Requires</dt><dd>{product.minimumMacOS} or newer</dd></div>
        <div><dt>Hardware</dt><dd>{product.architecture}</dd></div>
        <div>
          <dt>Current version</dt>
          <dd><a href="/changelog">{product.version}</a></dd>
        </div>
        <div><dt>Price</dt><dd>Free</dd></div>
      </dl>
      <p class="install-more">
        <a href="/download">Full install instructions, requirements, and update behaviour</a>
      </p>
    </div>
  </section>

  <section class="section faq-section">
    <div class="container faq-grid">
      <div class="faq-intro">
        <p class="eyebrow">Questions, answered</p>
        <h2>The practical details.</h2>
        <p class="section-copy">Still stuck? The support page has troubleshooting steps and the right place to report an issue.</p>
        <a class="button button--secondary" href="/support">Visit support</a>
      </div>
      <div class="faq-list">
        {faqs.map((item, index) => (
          <details open={index === 0}>
            <summary>{item.question}<span aria-hidden="true"></span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing-cta">
    <div class="container closing-cta-inner">
      <BrandMark size={64} />
      <div><h2>Every account visible. Every switch reversible.</h2><p>Change which account the CLI uses without changing anything else.</p></div>
      <a class="button button--primary button--large" href={product.links.download}>Download for Mac</a>
    </div>
  </section>
</BaseLayout>
