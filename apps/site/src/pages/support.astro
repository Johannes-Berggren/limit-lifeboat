---
import BrandMark from "../components/BrandMark.astro";
import { product } from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";

const description = `Troubleshooting for ${product.name}: install and update problems, accounts that will not register, switching failures, and macOS permission prompts.`;

// Question-form headings so each card is a self-contained answer, and so the FAQPage
// schema below has real questions to point at rather than topic labels.
const cards = [
  {
    id: "install",
    heading: "Why will the app not install or update?",
    icon: "M12 3v12m0 0 4-4m-4 4-4-4M5 21h14",
    tone: "violet",
    answer: `Limit Lifeboat requires an ${product.architecture} Mac running ${product.minimumMacOS} or newer; Intel Macs are not supported. For the DMG, drag the app into Applications before opening it. The app checks for updates daily by default and never installs one silently — every update waits for you to choose Install and Relaunch. Replacing the app in Applications preserves its Application Support and Keychain data.`,
    extras: [
      "Version 1.1.3 quits immediately after updating. Install 1.1.4 or newer over it to recover.",
    ],
    link: { href: "/download", label: "Install instructions" },
  },
  {
    id: "accounts",
    heading: "Why is an account missing or showing an old reading?",
    icon: "m5 7 4 4-4 4m6 0h8",
    tone: "cyan",
    answer:
      "Accounts register themselves from your existing CLI logins. Sign in with claude or codex login in Terminal, then refresh the app and the active account appears. An inactive account keeps its last successful reading and shows the age of that reading rather than presenting it as live. Readings older than 30 minutes are marked stale. If a saved login has expired, use that account's Log In or Retry action.",
    extras: [],
    link: {
      href: "/guides/claude-code-codex-usage-monitor-mac",
      label: "Why usage numbers disagree",
    },
  },
  {
    id: "switching",
    heading: "Why did a CLI switch fail or prompt me?",
    icon: "M8 7h11m0 0-3-3m3 3-3 3M16 17H5m0 0 3 3m-3-3 3-3",
    tone: "green",
    answer:
      "Switching changes the selected CLI login only — not your browser session and not the desktop app. A first switch may ask for macOS Terminal Automation permission. If another process changed the credentials while the switch was running, that external change wins and the switch aborts rather than overwriting it; retry once the other process has finished. If a rollback was not safe, the app keeps a protected recovery directory and tells you where it is.",
    extras: [],
    link: {
      href: "/guides/switch-claude-code-accounts-mac",
      label: "What a switch actually writes",
    },
  },
  {
    id: "permissions",
    heading: "Which macOS permissions does it need?",
    icon: "M12 4a6 6 0 0 0-6 6c0 7-3 7-3 7h18s-3 0-3-7a6 6 0 0 0-6-6Zm-2 16h4",
    tone: "amber",
    answer:
      "All of them are optional and none are requested until you use the feature that needs them. Notifications can be changed at any time in System Settings. Launch at login stays off until you enable it in Settings. Keychain prompts appear only for explicit actions that require authorization. Terminal Automation is requested the first time you switch.",
    extras: [],
    link: { href: "/privacy", label: "Privacy details" },
  },
] as const;

const faqs = [
  ...cards.map((card) => ({ question: card.heading, answer: card.answer })),
  {
    question: "How do I report a bug in Limit Lifeboat?",
    answer:
      "Open an issue on the GitHub issue tracker. Include the Limit Lifeboat version, your macOS version, the affected provider, what you expected, what happened, and the smallest sequence that reproduces it. Never attach real access tokens, refresh tokens, cookies, passwords, private keys, full Keychain exports, or unredacted account data.",
  },
  {
    question: "How do I report a security vulnerability?",
    answer:
      "Use GitHub private vulnerability reporting rather than a public issue. That keeps the details between you and the maintainer while the report is investigated.",
  },
];

const structuredData = [
  {
    "@type": "FAQPage",
    "@id": `${product.siteUrl}/support#faq`,
    mainEntity: faqs.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title="Support"
  description={description}
  breadcrumbs={[{ name: "Home", href: "/" }]}
  structuredData={structuredData}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><span>Support</span>
      </nav>
      <p class="eyebrow">Support</p>
      <h1>Let’s get it working.</h1>
      <p>Start with the quick checks below. If the issue persists, the GitHub issue tracker is the best place to get help.</p>
      <div class="hero-actions page-actions">
        <a class="button button--primary button--large" href={product.links.newIssue}>Open a GitHub issue</a>
        <a class="button button--secondary button--large" href="/guides">Read the guides</a>
      </div>
    </div>
  </section>

  <section class="section support-section">
    <div class="container support-grid">
      {
        cards.map((card) => (
          <article class="support-card" id={card.id}>
            <span class={`feature-icon feature-icon--${card.tone}`}>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d={card.icon} />
              </svg>
            </span>
            <h2>{card.heading}</h2>
            <p>{card.answer}</p>
            {card.extras.length > 0 && (
              <ul>
                {card.extras.map((extra) => (
                  <li>{extra}</li>
                ))}
              </ul>
            )}
            <a class="text-link" href={card.link.href}>
              {card.link.label} <span aria-hidden="true">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section diagnostic-section">
    <div class="container diagnostic-grid">
      <div>
        <p class="eyebrow">Before reporting a bug</p>
        <h2>A few details speed up the diagnosis.</h2>
        <p>Include the Limit Lifeboat version, your macOS version, the affected provider, what you expected, what happened, and the smallest sequence that reproduces it. The app’s Settings window has a Copy Diagnostics button that gathers most of this for you.</p>
      </div>
      <div class="privacy-warning">
        <BrandMark size={48} />
        <div>
          <h3>Remove secrets first</h3>
          <p>Never attach real access tokens, refresh tokens, cookies, passwords, private keys, full Keychain exports, or unredacted account data.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section security-report">
    <div class="container security-report-inner">
      <div>
        <p class="eyebrow">Security issue?</p>
        <h2>Report it privately.</h2>
        <p>Do not open a public issue for an undisclosed vulnerability. GitHub private vulnerability reporting keeps the details between you and the maintainer while the issue is investigated.</p>
      </div>
      <a class="button button--primary button--large" href={product.links.securityReport}>Submit a private report</a>
    </div>
  </section>
</BaseLayout>
